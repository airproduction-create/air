# ============================================================
# AIR CO — Environment Variables
# Copy to .env.local for local development.
# Add all variables to Netlify: Site Settings > Environment Variables
# ============================================================

# ── Frontend (Vite / Supabase) ─────────────────────────────
# Exposed to the browser. Use VITE_ prefix.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server-side (Netlify Functions only) ───────────────────
# These are NOT prefixed with VITE_ and are never exposed to the browser.

# Supabase — same URL as above, plus the service role key for write access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LinkedIn — see docs/linkedin-setup.md for OAuth setup guide
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token
LINKEDIN_ORGANIZATION_ID=your-company-page-numeric-id

# Freepik — image generation API
# Get your key at: https://www.freepik.com/api
FREEPIK_API_KEY=your-freepik-api-key

# Resend — transactional email for failure alerts
# Get your key at: https://resend.com
RESEND_API_KEY=re_your-resend-api-key

# Failure notification recipients
NOTIFICATION_EMAIL=your-email@example.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
